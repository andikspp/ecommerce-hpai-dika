# Salin menjadi .env.local lalu isi nilainya.

# URL backend Express. Dipakai untuk:
# - rewrite /api/* -> backend (next.config.mjs, dibaca saat build)
# - URL gambar produk (/uploads/...) di browser
NEXT_PUBLIC_API_URL=http://localhost:5000

# Opsional: URL backend khusus untuk rewrite, jika berbeda dari NEXT_PUBLIC_API_URL
# (misalnya alamat internal). Jika kosong, NEXT_PUBLIC_API_URL yang dipakai.
# BACKEND_URL=

# Midtrans Snap (Client Key memang publik, aman diekspos ke browser)
# Sandbox: https://app.sandbox.midtrans.com/snap/snap.js
# Production: https://app.midtrans.com/snap/snap.js
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
